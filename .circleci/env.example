# CircleCI Environment Variables
# Copy this file and set the values in your CircleCI project settings

# Docker Registry Configuration
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-password-or-token

# Database Configuration for Testing
DB_PASSWORD=exertion
DB_DATABASE=exertion_test
DB_USERNAME=exertion_user
DB_ROOT_PASSWORD=root

# Redis Configuration for Testing
REDIS_PASSWORD=redis

# Application Configuration
APP_ENV=testing
APP_DEBUG=false
APP_KEY=base64:your-test-app-key-here

# Optional: Notification Settings
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Optional: Deployment Configuration
STAGING_HOST=staging.your-domain.com
PRODUCTION_HOST=your-domain.com
SSH_KEY=your-ssh-private-key-for-deployment

# Optional: Code Quality Tools
SONAR_TOKEN=your-sonarqube-token
CODECOV_TOKEN=your-codecov-token
